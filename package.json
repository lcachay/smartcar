{
  "name": "smartcar",
  "version": "1.0.0",
  "description": "A Node.js project for smartcar functionality.",
  "main": "server.js",
  "dependencies": {
    "axios": "^1.12.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPatterns=integration",
    "start": "node server.js",
    "dev": "node server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
