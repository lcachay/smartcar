{
  "name": "smartcar",
  "version": "1.0.0",
  "description": "A Node.js project for smartcar functionality.",
  "main": "server.js",
  "dependencies": {
    "axios": "^1.12.2",
    "express": "^5.1.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=integration --testPathIgnorePatterns=raw --testPathIgnorePatterns=service",
    "test:integration": "jest --testPathPatterns=integration",
    "test:mm-raw": "jest --testPathPatterns=raw",
    "test:mm-service": "jest --testPathPatterns=service",
    "test:mm-all": "jest --testPathPatterns='raw|service'",
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "dev:debug": "cross-env NODE_ENV=development DEBUG=* nodemon server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
